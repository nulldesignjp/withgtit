/* ------------------------------

  component

------------------------------ */

@import '../mixins/index.styl'

.container

  padding 0 20px

.webglview
  position fixed
  left 0
  top 0
  width 100%
  height 100svh
  z-index -1
  background #181818

.siteNavigation
  ul
    margin 0
    padding 0
    line-height 1
    list-style-type none

    li
      display inline-block


a
  color #42affa

img
  border-radius vw(1.5)

header
  padding 20px 0

  h1.siteTitle
    margin 0
    padding 0
    line-height 1

  p.siteDescription
    margin 1em 0 0 0
    padding 0
    line-height 1

footer
  padding 20px 0

  p.copyright
    margin 0
    padding 0
    line-height 1



#portfolio
  iframe
    display block
    margin 1em 0
    width 100%
    min-height: vw(80)
    border none
    border-radius vw(2)
    pointer-events none

.archives

  li
    display inline-block
    margin-right vw(6)

    p
      margin-top vw(4)
      font-size small


#about

  img
    width vw(120)
    height auto

section

  ul
    margin 0
    padding 0
    line-height 1

    li
      margin 0
      padding 0
      line-height 1


      list-style-type none

      a
        img

          width 120px
          height auto