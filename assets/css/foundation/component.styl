/* ------------------------------

  component

------------------------------ */

@import '../mixins/index.styl'

.container
  padding 0 20px

a
  color #42affa

img
  border-radius vw(1.5)


header,
article,
footer
  margin 0
  padding 0
  display flex
  flex-direction column

header

  padding 16px
  gap 0.5em 

  h1
    margin 0
    line-height 1
    font-size 1em

  p
    margin 0
    line-height 1
    font-family: "EB Garamond", serif;
    font-size 0.75em

.navigation
  ul,
  li
    margin 0
    padding 0
    line-height 1
    font-size 0.75em
    list-style-type none
  
  ul
    li
      display inline-block
      margin-right 1em

article
  padding 0 16px
  font-size 75%

footer
  position fixed
  left 16px
  bottom 16px

  display grid
  grid-template-columns 1fr 10px
  
  p
    margin 0
    padding 0
    line-height 1
    font-size xx-small

    &.copyright
      opacity: 0.25

    &.sns
      width 10px
      height 10px
      aspect-ratio 1

      a
        display block
        width 100%
        height 100%
        background-color #42affa

        span
          position absolute
          top -9999px
          left -9999px

.webglview
  width 100vw
  height 100vh
  position fixed
  top 0
  left 0
  z-index -1